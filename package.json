{
  "name": "danang-vegan-guide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test --config=playwright.config.cjs",
    "format": "prettier --write \"assets/**/*.{js,css}\" sw.js \"tests/**/*.cjs\" package.json prettier.config.cjs playwright.config.cjs",
    "format:check": "prettier --check \"assets/**/*.{js,css}\" sw.js \"tests/**/*.cjs\" package.json prettier.config.cjs playwright.config.cjs",
    "verify:live": "node scripts/verify-live.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prettier": "3.9.10"
  }
}
